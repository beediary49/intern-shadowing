    "occurrences": [
      [
        1034.52,
        1066.48
      ]
    ]
  },
  {
    "start": 1066.56,
    "end": 1081.06,
    "text": "It's still so hard for me to grasp.",
    "repeats": 1,
    "occurrences": [
      [
        1066.56,
        1081.06
      ]
    ]
  },
  {
    "start": 1081.14,
    "end": 1113.64,
    "text": "I was in the kitchen making sandwiches, and his phone was there.",
    "repeats": 1,
    "occurrences": [
      [
        1081.14,
        1113.64
      ]
    ]
  },
  {
    "start": 1113.72,
    "end": 1138.24,
