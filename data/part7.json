      [
        4324.32,
        4334.08
      ]
    ]
  },
  {
    "start": 4334.16,
    "end": 4335.88,
    "text": "This is Jules.",
    "repeats": 1,
    "occurrences": [
      [
        4334.16,
        4335.88
      ]
    ]
  },
  {
    "start": 4335.96,
    "end": 4346.44,
    "text": "Hey, Alonzo, what's up?",
    "repeats": 1,
    "occurrences": [
      [
        4335.96,
        4346.44
      ]
    ]
  },
  {
    "start": 4346.52,
    "end": 4348.24,
    "text": "This is Jules.",
    "repeats": 1,
    "occurrences": [
      [
        4346.52,
        4348.24
      ]
    ]
  },
  {
    "start": 4348.32,
    "end": 4352.62,
    "text": "Hey, Alonzo, what's up?",
