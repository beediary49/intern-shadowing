    "repeats": 1,
    "occurrences": [
      [
        1289.76,
        1308.7
      ]
    ]
  },
  {
    "start": 1308.78,
    "end": 1337.84,
    "text": "Sometimes I'm not sure I know how to do that.",
    "repeats": 1,
    "occurrences": [
      [
        1308.78,
        1337.84
      ]
    ]
  },
  {
    "start": 1338.32,
    "end": 1358.74,
    "text": "You're not actually taking the rap for any of this, are you?",
