    "occurrences": [
      [
        1713.18,
        1753.9
      ]
    ]
  },
  {
    "start": 1753.98,
    "end": 1796.2,
    "text": "And anyway, there is something to be said about moving through it and focusing on us and not on the affair.",
    "repeats": 1,
    "occurrences": [
      [
        1753.98,
        1796.2
      ]
    ]
  },
  {
    "start": 1796.28,
    "end": 1812.28,
    "text": "I don't wanna give up on him.",
