    "occurrences": [
      [
        1812.36,
        1833.28
      ]
    ]
  },
  {
    "start": 1833.36,
    "end": 1871.44,
    "text": "But I am only human, and I am so mad at him.",
    "repeats": 1,
    "occurrences": [
      [
        1833.36,
        1871.44
      ]
    ]
  },
  {
    "start": 1871.52,
    "end": 1889.76,
    "text": "You know, so much has happened to us so fast.",
    "repeats": 1,
    "occurrences": [
      [
        1871.52,
        1889.76
      ]
    ]
  },
  {
