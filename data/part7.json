      [
        1113.72,
        1138.24
      ]
    ]
  },
  {
    "start": 1138.32,
    "end": 1153.84,
    "text": "And I don't know why, but I read them.",
    "repeats": 1,
    "occurrences": [
      [
        1138.32,
        1153.84
      ]
    ]
  },
  {
    "start": 1153.92,
    "end": 1167.64,
    "text": "It was not good.",
    "repeats": 1,
    "occurrences": [
      [
        1153.92,
        1167.64
      ]
    ]
  },
  {
    "start": 1167.72,
    "end": 1181.66,
    "text": "Does he know you know?",
    "repeats": 1,
    "occurrences": [
      [
        1167.72,
        1181.66
      ]
    ]
  },
  {
    "start": 1181.84,
    "end": 1211.68,
    "text": "'Cause, honestly, I'm not ready to deal with it.",
    "repeats": 1,
    "occurrences": [
      [
        1181.84,
        1211.68
      ]
    ]
  },
  {
    "start": 1211.76,
    "end": 1238.32,
    "text": "I would like to be a little less devastated, if that is possible.",
    "repeats": 1,
    "occurrences": [
      [
        1211.76,
        1238.32
      ]
    ]
  },
  {
    "start": 1238.4,
    "end": 1255.06,
    "text": "It's classic, though, isn't it?",
    "repeats": 1,
    "occurrences": [
      [
        1238.4,
        1255.06
      ]
    ]
  },
  {
    "start": 1255.14,
    "end": 1289.68,
    "text": "The successful wife. The husband feels like his manhood is threatened, so he acts out.",
    "repeats": 1,
    "occurrences": [
      [
        1255.14,
        1289.68
      ]
    ]
  },
  {
    "start": 1289.76,
    "end": 1308.7,
