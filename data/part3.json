    "repeats": 1,
    "occurrences": [
      [
        668.4,
        699.88
      ]
    ]
  },
  {
    "start": 699.96,
    "end": 703.12,
    "text": "Call me after.",
    "repeats": 1,
    "occurrences": [
      [
        699.96,
        703.12
      ]
    ]
  },
  {
    "start": 703.2,
    "end": 732.56,
    "text": "Oh, thanks, but you don't have to. I can open the door.",
    "repeats": 1,
    "occurrences": [
      [
        703.2,
        732.56
      ]
    ]
  },
  {
    "start": 732.64,
    "end": 760.24,
    "text": "Okay, so this shouldn't take more than an hour.",
    "repeats": 1,
    "occurrences": [
      [
        732.64,
        760.24
      ]
    ]
  },
  {
    "start": 760.48,
    "end": 820.96,
    "text": "But if you can't stay here, I'll call Becky, and then she'll find you, and then you can just pull up...",
    "repeats": 1,
    "occurrences": [
      [
        760.48,
        820.96
      ]
    ]
  },
  {
    "start": 821.04,
    "end": 843.56,
    "text": "Probably not.",
    "repeats": 1,
    "occurrences": [
      [
        821.04,
        843.56
      ]
    ]
  },
  {
    "start": 844.04,
    "end": 860.36,
    "text": "I think I forgot to eat today.",
    "repeats": 1,
    "occurrences": [
      [
        844.04,
        860.36
      ]
    ]
  },
  {
    "start": 860.44,
    "end": 878.36,
    "text": "Should I pick you up some sushi?",
    "repeats": 1,
    "occurrences": [
      [
        860.44,
        878.36
      ]
    ]
  },
  {
    "start": 878.44,
    "end": 908.32,
    "text": "No, I eat too much mercury.",
    "repeats": 1,
    "occurrences": [
      [
        878.44,
        908.32
      ]
    ]
  },
  {
    "start": 908.4,
    "end": 930.96,
    "text": "I'm actually kind of nauseous, so...",
    "repeats": 1,
    "occurrences": [
      [
        908.4,
        930.96
      ]
    ]
  },
  {
    "start": 931.04,
    "end": 956.96,
    "text": "That was fast. Not fast enough.",
    "repeats": 1,
    "occurrences": [
      [
        931.04,
        956.96
      ]
    ]
  },
  {
    "start": 957.04,
    "end": 979.16,
    "text": "Oh, I picked you up some soup from a place I know.",
