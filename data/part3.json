      [
        1400.88,
        1420.96
      ]
    ]
  },
  {
    "start": 1421.04,
    "end": 1422.48,
    "text": "Thank you.",
    "repeats": 1,
    "occurrences": [
      [
        1421.04,
        1422.48
      ]
    ]
  },
  {
