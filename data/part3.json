      [
        1215.24,
        1217.64
      ]
    ]
  },
  {
    "start": 1217.72,
    "end": 1221.48,
    "text": "Okay, then.",
    "repeats": 1,
    "occurrences": [
      [
        1217.72,
        1221.48
      ]
    ]
  },
  {
    "start": 1221.56,
    "end": 1237.92,
