    "occurrences": [
      [
        957.04,
        979.16
      ]
    ]
  },
  {
    "start": 979.24,
    "end": 998.76,
    "text": "You really didn't have to do...",
    "repeats": 1,
    "occurrences": [
      [
        979.24,
        998.76
      ]
    ]
  },
  {
    "start": 998.84,
    "end": 1001.8,
    "text": "Oh, my God, that smells so good.",
    "repeats": 1,
    "occurrences": [
      [
        998.84,
        1001.8
      ]
    ]
  },
  {
    "start": 1001.88,
    "end": 1018.36,
    "text": "Word travels fast.",
    "repeats": 1,
    "occurrences": [
      [
        1001.88,
        1018.36
      ]
    ]
  },
  {
    "start": 1018.44,
    "end": 1032.36,
    "text": "Pretty short meeting.",
    "repeats": 1,
    "occurrences": [
      [
        1018.44,
        1032.36
      ]
    ]
  },
  {
    "start": 1032.44,
    "end": 1050.92,
    "text": "I hated him.",
    "repeats": 1,
    "occurrences": [
      [
        1032.44,
        1050.92
      ]
    ]
  },
  {
    "start": 1051.0,
    "end": 1061.92,
    "text": "What happened?",
    "repeats": 1,
    "occurrences": [
      [
        1051.0,
        1061.92
      ]
    ]
  },
  {
    "start": 1062.0,
    "end": 1099.76,
    "text": "I thought he was a condescending, sexist know-it-all who did not seem to get what we do at all.",
    "repeats": 1,
    "occurrences": [
      [
        1062.0,
        1099.76
      ]
    ]
  },
  {
    "start": 1099.84,
    "end": 1154.76,
    "text": "And, honestly, I think he would run our business in a completely inorganic way that would lose us all the customers we have killed ourselves to get.",
    "repeats": 1,
    "occurrences": [
      [
        1099.84,
        1154.76
      ]
    ]
  },
  {
    "start": 1154.84,
    "end": 1183.92,
    "text": "Oh, and I think that he would replace us as soon as he got the chance.",
    "repeats": 1,
    "occurrences": [
      [
        1154.84,
        1183.92
      ]
    ]
  },
  {
    "start": 1184.0,
    "end": 1215.16,
    "text": "The man never blinked.",
