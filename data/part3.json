      [
        1259.16,
        1260.4
      ]
    ]
  },
  {
    "start": 1260.48,
    "end": 1263.08,
    "text": "Hey, don't be.",
    "repeats": 1,
    "occurrences": [
      [
        1260.48,
        1263.08
      ]
    ]
  },
  {
    "start": 1263.16,
    "end": 1292.72,
    "text": "I just wanted to say thank you for helping out with Mike today and for getting me chicken soup.",
